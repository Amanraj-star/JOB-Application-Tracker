PORT=5000

# Local MongoDB or a free Atlas cluster (https://www.mongodb.com/cloud/atlas)
MONGO_URI=mongodb://127.0.0.1:27017/job-tracker

# Generate a strong secret: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173
